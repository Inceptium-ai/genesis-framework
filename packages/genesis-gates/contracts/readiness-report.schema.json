{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis.dev/schemas/readiness-report.schema.json",
  "title": "Genesis Readiness Report",
  "description": "The agent-readiness audit produced by `genesis adopt` (run_audit): delivery-gate results, system-completeness gaps, env reconciliation, and structure facts rolled into a 0-100 score with receipts. v1.",
  "type": "object",
  "required": ["kind", "version", "repo", "generated_at", "readiness", "gates", "completeness", "env", "structure"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "GenesisReadinessReport" },
    "version": { "const": 1 },
    "repo": { "type": "string", "description": "Absolute path of the audited repository." },
    "generated_at": { "type": "string", "format": "date-time" },
    "readiness": {
      "type": "object",
      "required": ["score", "grade", "categories"],
      "additionalProperties": false,
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "grade": { "enum": ["A", "B", "C", "D", "F"] },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/categoryScore" } }
      }
    },
    "gates": {
      "type": "array",
      "description": "Delivery-gate results (same shape as EvidencePackage.gate_results).",
      "items": { "$ref": "#/$defs/gateResult" }
    },
    "completeness": {
      "type": "object",
      "required": ["profiles", "gaps"],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "description": "System profiles activated by marker text (e.g. auth, payments, file_upload).",
          "items": { "type": "string" }
        },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/completenessGap" } }
      }
    },
    "env": {
      "type": "object",
      "description": "Env reconciliation: the compose ${VAR} contract and direct code reads diffed against known dependencies.",
      "required": ["missing_required", "defaulted", "code_only"],
      "additionalProperties": false,
      "properties": {
        "missing_required": {
          "type": "array",
          "description": "Vars referenced with no default and no stored value — dependency rows to add.",
          "items": { "$ref": "#/$defs/dependency" }
        },
        "defaulted": {
          "type": "array",
          "description": "Vars covered by a compose default, e.g. \"DB_HOST (default: postgres)\".",
          "items": { "type": "string" }
        },
        "code_only": {
          "type": "array",
          "description": "Vars read directly by code but absent from the deploy contract.",
          "items": { "type": "string" }
        }
      }
    },
    "structure": {
      "type": "object",
      "description": "Repo structure facts feeding the readiness score and AGENTS.md draft.",
      "required": ["has_tests", "has_ci", "has_readme", "has_agents_md", "has_env_example", "has_lockfile", "has_dockerfile", "has_gitignore", "n_routes", "commands"],
      "additionalProperties": true,
      "properties": {
        "has_tests": { "type": "boolean" },
        "has_ci": { "type": "boolean" },
        "has_readme": { "type": "boolean" },
        "has_agents_md": { "type": "boolean" },
        "has_env_example": { "type": "boolean" },
        "has_lockfile": { "type": "boolean" },
        "has_dockerfile": { "type": "boolean" },
        "has_gitignore": { "type": "boolean" },
        "n_routes": { "type": "integer", "minimum": 0 },
        "commands": {
          "type": "object",
          "description": "Detected build/test/lint/dev commands, keyed by label.",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "ai_review": {
      "type": "object",
      "description": "Optional AI second-reader output (--review). Additive only — never alters the deterministic score."
    }
  },
  "$defs": {
    "categoryScore": {
      "type": "object",
      "required": ["key", "points", "max", "details"],
      "additionalProperties": false,
      "properties": {
        "key": { "enum": ["validation", "structure", "completeness", "env_hygiene"] },
        "points": { "type": "number", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "details": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gateResult": {
      "type": "object",
      "required": ["gate", "status"],
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string" },
        "status": { "enum": ["passed", "failed", "skipped", "error"] },
        "summary": { "type": "string" },
        "duration_s": { "type": "number" },
        "error": { "type": ["string", "null"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "finding": {
      "type": "object",
      "required": ["gate", "title", "severity"],
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "detail": { "type": "string" },
        "location": { "type": ["string", "null"] },
        "remediation": { "type": ["string", "null"] }
      }
    },
    "completenessGap": {
      "type": "object",
      "required": ["profile", "flow", "title", "brief"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string" },
        "flow": { "type": "string" },
        "title": { "type": "string" },
        "brief": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["env_var"],
      "additionalProperties": true,
      "properties": {
        "env_var": { "type": "string" },
        "type": { "type": "string" },
        "service": { "type": "string" },
        "required": { "type": "boolean" },
        "default_strategy": { "type": "string" },
        "default_value": { "type": ["string", "null"] },
        "doc_url": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "source_detected": { "type": "string" }
      }
    }
  }
}
