{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genesis.dev/schemas/task.schema.json",
  "title": "Genesis Task",
  "description": "A single build task from tasks.yaml — the unit of reviewable execution the pipeline decomposer emits and the executor implements. Mirrors the strict pydantic Task model; deliberately permissive (additionalProperties true) so newer producers stay readable by older consumers.",
  "type": "object",
  "required": ["id", "title", "acceptance_criteria"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^V\\d+_T\\d+$", "description": "e.g. V1_T3" },
    "title": { "type": "string", "minLength": 1 },
    "batch": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Issue-wave grouping: initial decompose = 1; later injections/changes increment."
    },
    "skills": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wireframe": { "type": ["string", "null"] },
        "integrations": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } }
      }
    },
    "user_story": { "type": "string" },
    "acceptance_flows": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "happy_path": { "type": "array", "items": { "$ref": "#/$defs/acceptanceStep" } },
        "error_handling": { "type": "array", "items": { "$ref": "#/$defs/errorCase" } }
      }
    },
    "api_contracts": { "type": "array", "items": { "$ref": "#/$defs/apiContract" } },
    "ui_components": { "type": "array", "items": { "$ref": "#/$defs/uiComponent" } },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "must_use": { "type": "array", "items": { "type": "string" } },
        "must_not": { "type": "array", "items": { "type": "string" } },
        "wireframe_first": { "type": ["boolean", "null"] }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "array", "items": { "$ref": "#/$defs/fileSpec" } },
        "modify": { "type": "array", "items": { "$ref": "#/$defs/fileSpec" } }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "validation": { "type": "array", "items": { "$ref": "#/$defs/validationRule" } }
  },
  "$defs": {
    "acceptanceStep": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "step": { "type": "integer" },
        "user_action": { "type": "string" },
        "system": { "type": "string" },
        "ui_component": { "type": ["string", "null"] },
        "api_endpoint": { "type": ["string", "null"] }
      }
    },
    "errorCase": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "trigger": { "type": "string" },
        "system": { "type": "string" },
        "user_sees": { "type": "string" }
      }
    },
    "apiContract": {
      "type": "object",
      "required": ["operationId", "method", "path"],
      "additionalProperties": true,
      "properties": {
        "operationId": { "type": "string" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "auth": { "type": ["string", "null"] },
        "content_type": { "type": ["string", "null"] },
        "request": { "type": ["object", "null"] },
        "responses": { "type": "object" }
      }
    },
    "uiComponent": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "wireframe_element": { "type": "string" },
        "behavior": { "type": "string" }
      }
    },
    "fileSpec": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "purpose": { "type": ["string", "null"] },
        "must_contain": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "validationRule": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "description": "file_exists | api_endpoint_responds | file_contains | command" },
        "path": { "type": ["string", "null"] },
        "endpoint": { "type": ["string", "null"] },
        "content": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] }
      }
    }
  }
}
